<%# Bulk Apply Modal - Apply a field value to selected rows (or all rows if none selected) %>
<div id="bulk-apply-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9998; align-items: center; justify-content: center;">
   <div style="background: white; border-radius: 4px; max-width: 680px; width: 90%; box-shadow: 0 4px 16px rgba(0,0,0,0.3); margin: 20px;">

      <!-- Header -->
      <div style="padding: 16px 20px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center; background: #f8f9fa; border-radius: 4px 4px 0 0;">
         <h5 class="mb-0" id="bulk-apply-modal-title" style="font-size: 1rem;"><%= Spree.t(:set_value, default: 'Set Value') %></h5>
         <button type="button" class="btn btn-link p-0" data-action="close-bulk-apply-modal" aria-label="Close">
            <span style="font-size: 22px; line-height: 1; color: #6c757d;">&times;</span>
         </button>
      </div>

      <!-- Body -->
      <div id="bulk-apply-modal-body" style="padding: 20px; position: relative;">
         <!-- Scope hint -->
         <div class="alert alert-info py-2 mb-3" id="bulk-apply-scope-banner">
            <small id="bulk-apply-scope-label"></small>
         </div>

         <!-- Available On field -->
         <div id="bulk-field-available_on" class="bulk-field-section" style="display: none;">
            <div class="form-group mb-0">
               <label class="font-weight-semibold"><%= Spree.t(:available_on) %></label>
               <div id="bulk-datepicker-anchor" style="position: relative;">
                  <div class="input-group" id="bulk-datepicker-wrapper">
                     <input type="text"
                            id="bulk-value-available-on"
                            class="form-control shadow-none"
                            placeholder="<%= Spree.t(:select_a_date) %>"
                            autocomplete="off">
                     <div class="input-group-append">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="bulk-datepicker-clear" tabindex="-1">&times;</button>
                     </div>
                  </div>
               </div>
            </div>
         </div>

         <!-- Shipping Category field -->
         <div id="bulk-field-shipping_category" class="bulk-field-section" style="display: none;">
            <div class="form-group mb-0">
               <label class="font-weight-semibold"><%= Spree.t(:shipping_category) %></label>
               <select id="bulk-value-shipping-category" class="w-100">
                  <option value="">— <%= Spree.t('match_choices.none') %> —</option>
                  <% (@shipping_categories || []).each do |category| %>
                     <option value="<%= category.id %>"><%= category.name %></option>
                  <% end %>
               </select>
            </div>
         </div>

         <!-- Vendor field -->
         <div id="bulk-field-vendor" class="bulk-field-section" style="display: none;">
            <div class="form-group mb-0">
               <label class="font-weight-semibold"><%= Spree.t(:vendor, default: 'Vendor') %></label>
               <select id="bulk-value-vendor" class="w-100">
               </select>
            </div>
         </div>

         <!-- Taxons field -->
         <div id="bulk-field-taxons" class="bulk-field-section" style="display: none;">
            <div class="form-group mb-0">
               <label class="font-weight-semibold"><%= Spree.t(:taxons) %></label>
               <select id="bulk-value-taxons" class="w-100" multiple>
               </select>
            </div>
         </div>
      </div>

      <!-- Footer -->
      <div style="padding: 12px 20px; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 8px;">
         <button type="button" class="btn btn-secondary" data-action="cancel-bulk-apply">
            <%= Spree.t(:cancel, default: 'Cancel') %>
         </button>
         <button type="button" class="btn btn-primary" data-action="confirm-bulk-apply">
            <span class="icon icon-check mr-1"></span>
            <%= Spree.t(:apply, default: 'Apply') %>
         </button>
      </div>

   </div>
</div>
