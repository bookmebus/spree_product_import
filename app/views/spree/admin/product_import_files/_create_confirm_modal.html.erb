<%# Create Confirmation Modal - shown before submitting the product import form %>
<div id="create-confirm-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000; align-items: center; justify-content: center;">
   <div style="background: white; border-radius: 4px; max-width: 480px; width: 90%; box-shadow: 0 4px 16px rgba(0,0,0,0.3); margin: 20px;">

      <!-- Header -->
      <div style="padding: 16px 20px; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center; background: #f8f9fa; border-radius: 4px 4px 0 0;">
         <h5 class="mb-0" style="font-size: 1rem;">
            <%= Spree.t(:confirm_create_products, default: 'Confirm Create Products') %>
         </h5>
         <button type="button" class="btn btn-link p-0" id="create-confirm-modal-close" aria-label="Close">
            <span style="font-size: 22px; line-height: 1; color: #6c757d;">&times;</span>
         </button>
      </div>

      <!-- Body -->
      <div style="padding: 20px;">
         <p id="create-confirm-modal-message" class="mb-0"></p>
      </div>

      <!-- Footer -->
      <div style="padding: 12px 20px; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 8px; background: #f8f9fa; border-radius: 0 0 4px 4px;">
         <button type="button" class="btn btn-secondary" id="create-confirm-modal-cancel">
            <%= Spree.t(:cancel, default: 'Cancel') %>
         </button>
         <button type="button" class="btn btn-success" id="create-confirm-modal-confirm">
            <%= Spree.t(:create_products, default: 'Create Products') %>
         </button>
      </div>
   </div>
</div>
